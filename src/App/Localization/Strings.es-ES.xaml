    <system:String x:Key="HeightLabel">Alto</system:String>
    <system:String x:Key="DisableAdvancedMode">Desactivar modo avanzado</system:String>
    <system:String x:Key="AdvancedResolutionInvalid">Escribe un ancho y alto válidos entre 16 y 8192.</system:String>
    <system:String x:Key="AdvancedModeEnabled">Modo avanzado activado</system:String>
    <system:String x:Key="AdvancedModeDisabled">Modo avanzado desactivado; se restauraron los valores normales</system:String>
